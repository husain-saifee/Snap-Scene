# ==========================================
# Snap-Scene Environment Configuration
# ==========================================

# OpenAI API Key (Required for story generation & scene planning)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: AIML API Key (for ByteDance Seedance Image-to-Video generation)
AIML_API_KEY=your_aiml_api_key_here
AIML_BASE_URL=https://api.aimlapi.com/v2

# Optional: Custom path to FFmpeg binary (defaults to system PATH 'ffmpeg')
FFMPEG_PATH=ffmpeg
